    { "source": "/styles/claymorphism", "destination": "/demo/vet?theme=soft-friendly", "permanent": true },
    { "source": "/styles/minimalism", "destination": "/demo/clinic?theme=clean-clinical", "permanent": true },
    { "source": "/styles/liquid-glass", "destination": "/demo/salon_beauty?theme=luxe-dark", "permanent": true }
