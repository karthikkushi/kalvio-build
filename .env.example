# Copy to .env for local builds, and set the same variables in Cloudflare Pages (Settings > Environment variables).
# Lead Finder Supabase project: URL + PUBLISHABLE key (sb_publishable_...). Never put a secret/service key here.
VITE_LEADFINDER_URL=https://<project-ref>.supabase.co
VITE_LEADFINDER_KEY=sb_publishable_...
# Used for canonical and og:url tags in prerendered pages.
SITE_ORIGIN=https://kalvio-build.pages.dev
